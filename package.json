{
  "name": "trama",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node_modules/.bin/tsc -b && node_modules/.bin/vite build",
    "preview": "vite preview",
    "test": "node_modules/.bin/vitest run",
    "test:watch": "node_modules/.bin/vitest",
    "test:coverage": "node_modules/.bin/vitest run --coverage",
    "e2e": "node_modules/.bin/playwright test",
    "e2e:ui": "node_modules/.bin/playwright test --ui",
    "e2e:install": "node_modules/.bin/playwright install --with-deps chromium",
    "typecheck": "node_modules/.bin/tsc -b",
    "db:up": "docker compose up -d postgres && sleep 3 && scripts/apply-migrations.sh",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres && sleep 3 && scripts/apply-migrations.sh",
    "db:psql": "docker exec -it trama-postgres psql -U trama -d trama"
  },
  "dependencies": {
    "@netlify/database": "^1.0.0",
    "@netlify/functions": "^5.2.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-virtual": "^3.13.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  }
}

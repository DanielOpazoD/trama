{
  "name": "trama",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "node_modules/.bin/vite",
    "build": "node_modules/.bin/tsc -b && node_modules/.bin/vite build",
    "check:legacy-fallback": "node scripts/check-legacy-fallback-prod.mjs",
    "check:runtime-api-routes": "node scripts/runtime-api-routes.mjs",
    "check:api-request-contracts": "node scripts/api-request-contracts.mjs",
    "check:api-error-shape": "node scripts/check-api-error-shape.mjs",
    "check:backend-domain-services": "node scripts/backend-domain-services.mjs",
    "check:row-runtime-contracts": "node scripts/check-row-runtime-contracts.mjs",
    "check:operational-observability": "node scripts/operational-observability-contracts.mjs",
    "check:storage-boundaries": "node scripts/storage-boundaries.mjs",
    "cleanup:runtime-fixtures": "node scripts/cleanup-runtime-fixtures.mjs",
    "check:hard-delete-allowlist": "node scripts/check-hard-delete-allowlist.mjs",
    "check:auth-rls-contracts": "node scripts/auth-rls-contracts.mjs",
    "check:legacy-identity-contracts": "node scripts/legacy-identity-contracts.mjs",
    "check:legacy-identity-schema": "node scripts/check-legacy-identity-schema.mjs",
    "check:legacy-media-fallbacks": "node scripts/check-legacy-media-fallbacks.mjs",
    "check:user-id-writes": "node scripts/user-id-write-contracts.mjs",
    "legacy-identity:report": "node scripts/legacy-identity-report.mjs",
    "legacy-data-reassignment:dry-run": "node scripts/legacy-data-reassignment-dry-run.mjs",
    "storage-assets:report": "node scripts/storage-assets-report.mjs",
    "storage:orphans:dry-run": "node scripts/check-storage-orphans.mjs",
    "check:migration-duplicates": "node scripts/check-migration-duplicates.mjs",
    "architecture-map:build": "node scripts/architecture-map.mjs --build",
    "check:architecture-map": "node scripts/architecture-map.mjs",
    "check:docs-drift": "node scripts/check-docs-drift.mjs",
    "check:script-registry": "node scripts/check-script-registry.mjs",
    "check:mock-completeness": "node scripts/check-mock-completeness.mjs",
    "check:knip": "node_modules/.bin/knip --no-progress --reporter compact",
    "check:dead-code": "node_modules/.bin/knip --no-progress --reporter compact",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:adr-index": "node scripts/check-adr-index.mjs",
    "check:dependency-cruiser": "node scripts/check-architecture-boundaries.mjs",
    "check:deps-advisories": "node scripts/check-deps-advisories.mjs",
    "report:quality-gates": "node scripts/report-quality-gates.mjs",
    "check:structure-ratchets": "node scripts/check-structure-ratchets.mjs",
    "check:frontend-boundaries": "node scripts/check-frontend-boundaries.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:modal-overlay": "node scripts/check-modal-overlay.mjs",
    "check:form-control-labels": "node scripts/check-form-control-labels.mjs",
    "check:icon-button": "node scripts/check-icon-button.mjs",
    "check:focus-ring": "node scripts/check-focus-ring.mjs",
    "check:pdf-runtime-boundaries": "node scripts/pdf-runtime-boundaries.mjs",
    "check:pdf-lazy-entrypoints": "node scripts/pdf-lazy-entrypoints.mjs",
    "check:client-api-contracts": "node scripts/client-api-contracts.mjs",
    "client-api-contracts:inventory": "node scripts/client-api-contracts.mjs --json",
    "check:cte-regression": "bash scripts/check-cte-regression.sh",
    "check:query-plans": "node scripts/check-query-plans.mjs",
    "local:db-confidence": "node scripts/local-db-confidence.mjs",
    "check:whatsapp-schema": "node scripts/check-whatsapp-schema.mjs",
    "check:pdf-stamp-assets-schema": "node scripts/check-pdf-stamp-assets-schema.mjs",
    "test:whatsapp-it": "node scripts/run-vitest.mjs run netlify/functions/_lib/whatsapp-persist.integration.test.ts",
    "test:query-it": "node scripts/run-vitest.mjs run netlify/functions/_lib/query.integration.test.ts",
    "test:query-it:local": "node scripts/run-query-integration-local.mjs",
    "test:backend-data-it": "node scripts/run-backend-data-integration-local.mjs",
    "pr-stack:check": "node scripts/verify-pr-stack.mjs",
    "bench:search-scale": "node scripts/search-scale-benchmark.mjs",
    "bench:search-scale:portable": "SEARCH_BENCHMARK_SCHEMA=portable node scripts/search-scale-benchmark.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "bundle:report": "node scripts/check-bundle-size.mjs --report",
    "pdf:runtime-inventory": "node scripts/pdf-runtime-inventory.mjs",
    "lighthouse:summary": "node scripts/lighthouse-report-summary.mjs",
    "preview": "node_modules/.bin/vite preview",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:coverage": "node scripts/run-vitest.mjs run --coverage",
    "e2e": "node_modules/.bin/playwright test",
    "e2e:pdf-visual": "PDF_STUDIO_VISUAL=1 node_modules/.bin/playwright test e2e/pdf-studio-visual.spec.ts --project=chromium",
    "e2e:focus-visual": "PDF_STUDIO_VISUAL=1 node_modules/.bin/playwright test e2e/focus-ring-visual.spec.ts --project=chromium",
    "e2e:pdf-stamps-smoke": "PDF_STAMP_ASSETS_SMOKE=1 node_modules/.bin/playwright test e2e/pdf-studio-editor.spec.ts --project=chromium --grep \"persiste firma dibujada\"",
    "e2e:visual-sweep": "VISUAL_SWEEP=1 node_modules/.bin/playwright test e2e/visual-sweep.spec.ts --project=chromium",
    "e2e:multiuser": "node scripts/run-multiuser-smoke.mjs",
    "cutover:preflight": "node scripts/cutover-preflight.mjs",
    "cutover:smoke": "node scripts/run-cutover-smoke.mjs",
    "cutover:smoke:isolation": "node scripts/run-cutover-isolation-smoke.mjs",
    "cutover:smoke:legacy-identity": "node scripts/run-legacy-identity-smoke.mjs",
    "smoke:multiuser:prod": "node scripts/smoke-isolation.mjs",
    "smoke:production-report": "node scripts/multiuser-production-report.mjs",
    "e2e:ui": "node_modules/.bin/playwright test --ui",
    "e2e:install": "node_modules/.bin/playwright install --with-deps chromium",
    "typecheck": "node_modules/.bin/tsc -b && npm run check:extension-types",
    "check:extension-types": "node_modules/.bin/tsc -p extension/tsconfig.json",
    "lint": "node_modules/.bin/eslint .",
    "lint:fix": "node_modules/.bin/eslint . --fix",
    "format": "node_modules/.bin/prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "git ls-files -z -- '*.ts' '*.tsx' '*.js' '*.mjs' '*.json' '*.md' '*.yml' '*.yaml' | xargs -0 node_modules/.bin/prettier --check",
    "prepare": "husky",
    "db:up": "docker compose up -d postgres && sleep 3 && scripts/apply-migrations.sh",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres && sleep 3 && scripts/apply-migrations.sh",
    "db:psql": "docker exec -it trama-postgres psql -U trama -d trama",
    "capturas": "TRAMA_CAPTURAS=1 playwright test e2e/capturas-readme.spec.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clerk/backend": "^3.16.5",
    "@clerk/react": "^6.7.2",
    "@netlify/blobs": "^10.7.8",
    "@netlify/database": "^1.0.0",
    "@netlify/functions": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/qrcode": "^1.5.6",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.11",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sigma": "^3.0.3",
    "tesseract.js": "^7.0.0",
    "web-vitals": "^5.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "happy-dom": "^20.10.1",
    "husky": "^9.1.7",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.7",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}

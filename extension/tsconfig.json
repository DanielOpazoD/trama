{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["*.js", "lib/*.js", "types.d.ts"],
  "exclude": ["**/*.cjs", "icons/**", "**/*.test.js"]
}

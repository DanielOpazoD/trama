# Copy this file to .env (gitignored) for local dev.

# Local Postgres provisioned by `npm run db:up` (docker-compose.yml).
NETLIFY_DATABASE_URL=postgresql://trama:trama_local_dev@localhost:5433/trama

# LLM provider config.
# Get a key from platform.deepseek.com (or use openai/anthropic/gemini).
AI_PROVIDER=deepseek
AI_API_KEY=

# Optional caps. Defaults shown.
AI_MAX_TOKENS=4096
AI_CACHE_TTL_SECONDS=600
AI_MONTHLY_BUDGET_CENTS=500

# Spotify OAuth (optional — Trama works fine without it)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/api/spotify/callback

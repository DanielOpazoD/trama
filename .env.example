# Copy this file to .env (gitignored) for local dev.

# Local Postgres provisioned by `npm run db:up` (docker-compose.yml).
NETLIFY_DB_URL=postgresql://trama:trama_local_dev@localhost:5433/trama

# LLM provider config.
# Get a key from platform.deepseek.com (or use openai/anthropic/gemini).
AI_PROVIDER=deepseek
AI_API_KEY=

# Optional caps. Defaults shown.
AI_MAX_TOKENS=4096
AI_CACHE_TTL_SECONDS=600
AI_MONTHLY_BUDGET_CENTS=5000

# Auth rollout.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
LEGACY_OWNER_CLERK_ID=
ALLOW_LEGACY_FALLBACK=true

# Spotify OAuth (optional — Trama works fine without it)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/api/spotify/callback

# WhatsApp vía Twilio (optional — captura por mensaje).
# Auth Token de la consola de Twilio: firma los webhooks entrantes.
# Si está vacío, el webhook NO verifica firma (solo dev local).
TWILIO_AUTH_TOKEN=
# Solo si la URL pública difiere de la que ve la función (proxy/redirect):
# la URL EXACTA configurada en Twilio para el webhook. Si se omite, se usa
# la URL del request.
# TWILIO_WEBHOOK_URL=https://tramadaod.netlify.app/api/whatsapp-webhook
# Número de WhatsApp de Trama (el "bot"), en E164. Habilita el QR + botón
# "Abrir WhatsApp" del onboarding de un toque. Es público (va al cliente).
# Para el sandbox de Twilio, usar su número compartido (ej. +14155238886).
VITE_WHATSAPP_NUMBER=

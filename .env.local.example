# Clerk — Auth (multi-usuario)
# Obtener en: https://dashboard.clerk.com → Tu app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REEMPLAZAR
CLERK_SECRET_KEY=sk_test_REEMPLAZAR

# Multi-user transition
# Mantener en 'true' hasta que Sprint 2 esté completo y todos los
# endpoints filtren por user_id. Cuando esté listo: quitar o poner 'false'.
ALLOW_LEGACY_FALLBACK=true

# Owner alias: sub de Clerk del dueño histórico. Cuando ESE usuario entra
# con Clerk, se mapea al dueño 'legacy-single-user' y ve toda la data
# pre-Clerk (entidades, citas, momentos, multimedia) sin migrar nada. El
# resto de usuarios usan su sub real. Buscarlo en dashboard.clerk.com →
# Users → tu usuario → "User ID" (formato user_xxx). Dejar vacío si no se
# usa. Quitar en la migración multi-user definitiva.
LEGACY_OWNER_CLERK_ID=user_REEMPLAZAR

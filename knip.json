    "netlify/functions/**/*.{ts,mts}",
    "scripts/**/*.{mjs,ts}",
    "extension/**/*.ts",
    "e2e/**/*.ts",
    "*.{js,cjs,mjs,ts}",
    ".github/workflows/*.{yml,yaml}"

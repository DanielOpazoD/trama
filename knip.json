{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "src/test-setup.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tailwind.config.js",
    "postcss.config.js",
    "playwright*.config.ts",
    "extension/**/*.ts",
    "netlify/functions/**/*.mts",
    "netlify/functions/**/*.ts",
    "scripts/**/*.{mjs,ts}",
    "e2e/**/*.ts",
    "src/**/*.test.{ts,tsx}",
    "netlify/functions/**/*.test.ts",
    "scripts/**/*.test.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "netlify/functions/**/*.{ts,mts}",
    "scripts/**/*.{mjs,ts}",
    "extension/**/*.ts",
    "e2e/**/*.ts",
    "*.{js,cjs,mjs,ts}",
    ".github/workflows/*.{yml,yaml}"
  ],
  "ignore": [
    ".agents/**",
    ".claude/**",
    ".netlify/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "ignoreDependencies": ["dependency-cruiser", "pg", "playwright"],
  "ignoreBinaries": ["psql", "scripts/apply-migrations.sh"],
  "ignoreIssues": {
    "src/api/ai-settings.ts": ["types"],
    "src/api/atlas.ts": ["types"],
    "src/api/cronologia.ts": ["types"],
    "src/api/entities.ts": ["types"],
    "src/api/graph.ts": ["types"],
    "src/api/index.ts": ["types"],
    "src/api/notasFeed.ts": ["types"],
    "src/api/query.ts": ["types"],
    "src/api/request.ts": ["exports"],
    "src/api/search.ts": ["types"],
    "src/api/spotify.ts": ["types"],
    "src/components/momentos/editModal/FotoPhotoTile.tsx": ["types"],
    "src/components/notas/pdfStudio/editor/pdfAnnotationDrawing.ts": ["types"],
    "src/components/notas/pdfStudio/planillas/fill/pdfTemplateFillImport.ts": ["types"],
    "src/lib/libro/libroModel.ts": ["types"],
    "src/lib/oauthReturn.ts": ["types"],
    "src/lib/pdfStudio/export/heavyOperationClient.ts": ["types"],
    "src/lib/pdfStudio/export/heavyOperationContract.ts": ["types"],
    "src/lib/pdfStudio/forms/pdfFormWorkerContract.ts": ["types"],
    "src/lib/pdfStudio/import/recortesToPdfFiles.ts": ["types"],
    "src/lib/pdfStudio/model/model.ts": ["types"],
    "src/lib/pdfStudio/model/modelTypes.ts": ["types"],
    "src/lib/pdfStudio/preflight/pdfStudioPreflight.ts": ["types"],
    "src/lib/pdfStudio/render/persistence.ts": ["types"],
    "src/lib/season.ts": ["types"],
    "src/lib/vaultCrypto.ts": ["types"],
    "src/state/index.ts": ["exports", "types"],
    "src/state/toast.tsx": ["types"],
    "src/state/useNotasFeed.ts": ["types"],
    "src/state/useQuotes.ts": ["types"],
    "src/state/useReadingTables.ts": ["exports"],
    "src/state/useSavedQueries.ts": ["exports"],
    "src/types/extraction.ts": ["types"],
    "src/types/import-export.ts": ["types"],
    "src/types/origin.ts": ["types"]
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "src/test-setup.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tailwind.config.js",
    "postcss.config.js",
    "playwright*.config.ts",
    "extension/**/*.ts",
    "netlify/functions/**/*.mts",
    "netlify/functions/**/*.ts",
    "scripts/**/*.{mjs,ts}",
    "e2e/**/*.ts",
    "src/**/*.test.{ts,tsx}",
    "netlify/functions/**/*.test.ts",
    "scripts/**/*.test.mjs"

# Copia este archivo a .env y completa los valores.

# Credenciales de la API de Telegram (gratis): https://my.telegram.org
# -> API development tools -> crea una app y copia api_id y api_hash.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Clave de la API de Claude (https://platform.claude.com). OPCIONAL:
# sin ella el programa funciona igual, pero solo con CrossRef (sin
# clasificación temática; todo va a "Sin clasificar").
ANTHROPIC_API_KEY=

# Tu correo para el "polite pool" de CrossRef. Opcional pero recomendado.
CROSSREF_MAILTO=
